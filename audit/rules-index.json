{
  "version": "0.2.0",
  "topics": [
    {
      "prefix": "NC",
      "topic": "native-controls",
      "title": "Native controls",
      "file": "01-native-controls.md",
      "when": "Adding or touching any form control, dropdown, select, date or time picker, file upload, slider, colour input, checkbox, radio, tooltip, confirm/alert dialog, scrollable area or menu."
    },
    {
      "prefix": "TK",
      "topic": "design-tokens",
      "title": "Design tokens",
      "file": "02-design-tokens.md",
      "when": "Starting a UI, creating the theme or global stylesheet, or about to type a colour, pixel value, radius, shadow, z-index or duration into a component."
    },
    {
      "prefix": "TY",
      "topic": "typography",
      "title": "Typography",
      "file": "03-typography.md",
      "when": "Choosing or loading fonts, setting up the type scale, styling headings or body text, or laying out numbers and tables."
    },
    {
      "prefix": "SP",
      "topic": "spacing-layout",
      "title": "Spacing and layout",
      "file": "04-spacing-layout.md",
      "when": "Laying out a page or section, setting padding, margin or gap, building cards, lists, grids, sidebars or page containers."
    },
    {
      "prefix": "SL",
      "topic": "ai-slop",
      "title": "AI-slop blocklist",
      "file": "05-ai-slop.md",
      "when": "Designing a landing page, hero, feature section, dashboard, card grid or any new visual direction; choosing backgrounds, gradients, shadows, icons or decorative elements."
    },
    {
      "prefix": "ST",
      "topic": "component-states",
      "title": "Component states",
      "file": "06-component-states.md",
      "when": "Building any interactive element (button, link, input, row, tab, card action) or any view that loads, lists, saves or deletes data."
    },
    {
      "prefix": "FM",
      "topic": "forms",
      "title": "Forms",
      "file": "07-forms.md",
      "when": "Building or editing any form, input, sign-in or sign-up screen, settings page, search box, filter bar or inline edit."
    },
    {
      "prefix": "RS",
      "topic": "responsive",
      "title": "Responsive design",
      "file": "08-responsive.md",
      "when": "Building any page layout, navigation, table, grid or overlay; before declaring a page done on desktop; whenever fixed widths or heights are being set."
    },
    {
      "prefix": "DM",
      "topic": "dark-mode",
      "title": "Dark mode",
      "file": "09-dark-mode.md",
      "when": "Defining colour tokens, adding a theme switch, or styling any surface, border, shadow, image or chart that must work on a dark background."
    },
    {
      "prefix": "AX",
      "topic": "accessibility",
      "title": "Accessibility",
      "file": "10-accessibility.md",
      "when": "Building any interactive component, choosing text or border colours, adding images or icons, handling focus, writing custom widgets, or reviewing a page before completion."
    },
    {
      "prefix": "MO",
      "topic": "motion",
      "title": "Motion",
      "file": "11-motion.md",
      "when": "Adding transitions, animations, hover effects, page or overlay entrances, loading indicators or scroll effects."
    },
    {
      "prefix": "CO",
      "topic": "colour",
      "title": "Colour",
      "file": "12-colour.md",
      "when": "Creating or changing the palette, choosing a primary or accent colour, colouring status, charts, badges or backgrounds."
    },
    {
      "prefix": "FD",
      "topic": "finishing-details",
      "title": "Finishing details",
      "file": "13-finishing-details.md",
      "when": "Setting up the document head or root layout, adding images, toasts, modals or overlays, creating error pages, or preparing a project for review or launch."
    },
    {
      "prefix": "CP",
      "topic": "copy",
      "title": "Copy and microcopy",
      "file": "14-copy.md",
      "when": "Writing any text a user will read - headings, button labels, form labels, error messages, empty states, toasts, placeholder data, meta descriptions."
    },
    {
      "prefix": "BR",
      "topic": "brand-intake",
      "title": "Brand intake",
      "file": "15-brand-intake.md",
      "when": "Starting UI work in a project for the first time, starting a new product, page or redesign, or whenever design.md is missing or does not answer a design question."
    },
    {
      "prefix": "SA",
      "topic": "self-audit",
      "title": "Self-audit gate",
      "file": "16-self-audit.md",
      "when": "Before reporting any UI task as done, before opening a pull request that touches UI, or when asked to review or audit an interface."
    },
    {
      "prefix": "DT",
      "topic": "data-tables",
      "title": "Data tables",
      "file": "17-data-tables.md",
      "when": "Showing rows of records (lists of users, orders, invoices, logs, search results), building an admin screen or dashboard table, or adding sorting, filtering, selection or pagination to one."
    },
    {
      "prefix": "CH",
      "topic": "charts",
      "title": "Charts and data visualisation",
      "file": "18-charts.md",
      "when": "Adding a chart, graph, sparkline, KPI tile with a trend, gauge or any visual summary of numbers to a dashboard, report or landing page; choosing a chart library or its colours."
    },
    {
      "prefix": "NV",
      "topic": "navigation",
      "title": "Navigation and page structure",
      "file": "19-navigation.md",
      "when": "Building the app shell, header, sidebar, tabs, breadcrumbs or page header; adding a new page or route; deciding where a page's title and main actions go."
    },
    {
      "prefix": "IC",
      "topic": "icons",
      "title": "Icons",
      "file": "20-icons.md",
      "when": "Adding, choosing or sizing an icon; building icon buttons, navigation items, badges, empty states or status messages with icons; importing an icon library or inline SVG."
    },
    {
      "prefix": "IN",
      "topic": "internationalisation",
      "title": "Internationalisation and right-to-left",
      "file": "21-internationalisation.md",
      "when": "The product is or will be translated, supports right-to-left languages (Arabic, Hebrew, Persian, Urdu), shows dates, numbers, currencies or plurals, or sets fixed widths on text."
    }
  ],
